+    pub fn diagnose_work<T>(
+        &self,
+        case: &Case,
+        api: &str,
+        counters: &[syntaqs_core::probe_work::Counter],
+        call: impl FnOnce() -> T,
+    ) {
+        use std::sync::atomic::Ordering::Relaxed;
+        use syntaqs_core::probe_work::{Counter, LIVE_INDEX_ENTRIES};
+
+        if let Some(id) = self.diagnostic_id(case, api) {
+            counters.iter().for_each(|counter| {
+                counter.take();
+            });
+            let live_before = LIVE_INDEX_ENTRIES.load(Relaxed);
+            let result = black_box(call());
+            for counter in counters {
+                println!("{id},{},{}", counter.name(), counter.take());
+            }
+            if counters
+                .iter()
+                .any(|c| matches!(c, Counter::FactorIndexBuilds))
+            {
+                let live_after = LIVE_INDEX_ENTRIES.load(Relaxed);
+                println!("{id},retained_index_entries,{}", live_after - live_before);
+            }
+            drop(result);
+        }
+    }
