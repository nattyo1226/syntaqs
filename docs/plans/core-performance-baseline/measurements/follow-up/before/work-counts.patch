+
+impl<I> Drop for FactorPositions<'_, I> {
+    fn drop(&mut self) {
+        if let Some(positions) = self.by_index.get() {
+            crate::probe_work::LIVE_INDEX_ENTRIES
+                .fetch_sub(positions.len(), core::sync::atomic::Ordering::Relaxed);
+        }
     }
 }

