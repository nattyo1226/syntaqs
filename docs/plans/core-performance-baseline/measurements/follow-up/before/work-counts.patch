+//! Counters for the single-threaded follow-up reference probe.
+
+use core::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+
+#[derive(Clone, Copy)]
+pub enum Counter {
+    ZeroProductContinuations,
+    ZeroOperatorSumBranches,
+    TensorChildTasks,
+    TensorInputArrays,
+    TensorResultArrays,
+    TensorKeyLookups,
+    FactorIndexBuilds,
+}
+
+pub const ACTION: &[Counter] = &[
+    Counter::ZeroProductContinuations,
+    Counter::ZeroOperatorSumBranches,
+    Counter::TensorChildTasks,
+    Counter::TensorInputArrays,
+    Counter::TensorResultArrays,
+    Counter::TensorKeyLookups,
+];
+
+pub const FACTOR_INDEX: &[Counter] = &[Counter::FactorIndexBuilds];
+
+static COUNTS: [AtomicUsize; 7] = [const { AtomicUsize::new(0) }; 7];
+pub static LIVE_INDEX_ENTRIES: AtomicUsize = AtomicUsize::new(0);
+
+impl Counter {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::ZeroProductContinuations => "zero_product_continuations",
+            Self::ZeroOperatorSumBranches => "zero_operator_sum_branches",
+            Self::TensorChildTasks => "tensor_child_tasks",
+            Self::TensorInputArrays => "tensor_input_arrays",
+            Self::TensorResultArrays => "tensor_result_arrays",
+            Self::TensorKeyLookups => "tensor_key_lookups",
+            Self::FactorIndexBuilds => "factor_index_builds",
+        }
+    }
+
+    pub fn add(self, count: usize) {
+        COUNTS[self as usize].fetch_add(count, Relaxed);
+    }
+
+    pub fn take(self) -> usize {
+        COUNTS[self as usize].swap(0, Relaxed)
+    }
+}
