+//! Temporary timing instrumentation for the bottleneck investigation.
+
+use std::{cell::RefCell, collections::BTreeMap, time::Instant};
+
+thread_local! {
+    static TOTALS: RefCell<BTreeMap<&'static str, (u64, u128)>> = RefCell::default();
+}
+
+pub(crate) fn time<T>(label: &'static str, f: impl FnOnce() -> T) -> T {
+    let start = Instant::now();
+    let value = f();
+    let nanos = start.elapsed().as_nanos();
+    TOTALS.with(|totals| {
+        let mut totals = totals.borrow_mut();
+        let (calls, total_nanos) = totals.entry(label).or_default();
+        *calls += 1;
+        *total_nanos += nanos;
+    });
+    value
+}
+
+pub fn print_and_reset(stage: &str) {
+    TOTALS.with(|totals| {
+        for (label, (calls, nanos)) in std::mem::take(&mut *totals.borrow_mut()) {
+            println!("# profile,{stage},{label},{calls},{:.6}", nanos as f64 / 1e6);
+        }
+    });
+}
