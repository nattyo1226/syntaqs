+//! Timers for the isolated Lie-analysis profiling build.
+
+extern crate std;
+
+pub use self::std::time::Instant;
+use self::std::{
+    cell::{Cell, RefCell},
+    collections::BTreeMap,
+    time::Duration,
+};
+
+type Key = (&'static str, &'static str);
+
+#[derive(Default)]
+struct Sample {
+    calls: u64,
+    elapsed: Duration,
+    terms: u64,
+    local_traces: u64,
+}
+
+std::thread_local! {
+    static PHASE: Cell<&'static str> = const { Cell::new("root") };
+    static TOTALS: RefCell<BTreeMap<Key, Sample>> = RefCell::default();
+}
+
+fn record(key: Key, elapsed: Duration, calls: u64, terms: u64, local_traces: u64) {
+    TOTALS.with_borrow_mut(|totals| {
+        let sample = totals.entry(key).or_default();
+        sample.elapsed += elapsed;
+        sample.calls += calls;
+        sample.terms += terms;
+        sample.local_traces += local_traces;
+    });
+}
+
+pub fn observe(
+    operation: &'static str,
+    elapsed: Duration,
+    calls: u64,
+    terms: u64,
+    local_traces: u64,
+) {
+    record(
+        (PHASE.get(), operation),
+        elapsed,
+        calls,
+        terms,
+        local_traces,
+    );
+}
+
+pub fn measure<T>(operation: &'static str, run: impl FnOnce() -> T) -> T {
+    let start = Instant::now();
+    let result = run();
+    observe(operation, start.elapsed(), 1, 0, 0);
+    result
+}
+
+pub fn phase<T>(phase: &'static str, run: impl FnOnce() -> T) -> T {
+    let parent = PHASE.replace(phase);
+    let start = Instant::now();
+    let result = run();
+    let elapsed = start.elapsed();
+    PHASE.set(parent);
+    record((phase, "phase_total"), elapsed, 1, 0, 0);
+    result
+}
+
+pub fn print_and_reset(stage: &str) {
+    let samples = TOTALS.with_borrow_mut(core::mem::take);
+    for ((phase, operation), sample) in samples {
+        std::println!(
+            "# hotspot,{stage},{phase},{operation},{},{:.6},{},{}",
+            sample.calls,
+            sample.elapsed.as_secs_f64() * 1e3,
+            sample.terms,
+            sample.local_traces
+        );
+    }
+}
